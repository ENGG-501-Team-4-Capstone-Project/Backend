{
  "name": "Backend",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && prisma generate && prisma db seed"
  },
  "dependencies": {
    "@eslint/compat": "^2.0.2",
    "@fastify/cors": "^10.0.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.4.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.13.6",
    "@types/pg": "^8.18.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
